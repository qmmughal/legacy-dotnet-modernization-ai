{
  "ReverseProxy": {
    "Routes": {
      "modern-orders":   { "ClusterId": "modern", "Order": 10, "Match": { "Path": "/orders/{**rest}" } },
      "modern-api":      { "ClusterId": "modern", "Order": 10, "Match": { "Path": "/api/{**rest}" } },
      "modern-login":    { "ClusterId": "modern", "Order": 10, "Match": { "Path": "/account/login" } },
      "modern-logout":   { "ClusterId": "modern", "Order": 10, "Match": { "Path": "/account/logout" } },
      "modern-blazor":   { "ClusterId": "modern", "Order": 10, "Match": { "Path": "/_blazor/{**rest}" } },
      "modern-framework":{ "ClusterId": "modern", "Order": 10, "Match": { "Path": "/_framework/{**rest}" } },
      "modern-css":      { "ClusterId": "modern", "Order": 10, "Match": { "Path": "/css/{**rest}" } },
      "legacy-fallback": { "ClusterId": "legacy", "Order": 1000, "Match": { "Path": "/{**catch-all}" } }
    },
    "Clusters": {
      "modern": { "Destinations": { "web": { "Address": "https://localhost:7180/" } } },
      "legacy": { "Destinations": { "iis": { "Address": "https://legacy.meridianparts.example/" } } }
    }
  },
  "Logging": { "LogLevel": { "Default": "Information", "Yarp": "Warning" } }
}
