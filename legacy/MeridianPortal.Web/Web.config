<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <appSettings>
    <add key="PricingServiceUrl" value="https://apps.meridianparts.example/pricing/PricingService.svc" />
    <add key="FreeFreightThreshold" value="500" />
    <add key="SmtpHost" value="mail.meridianparts.example" />
  </appSettings>
  <connectionStrings>
    <add name="MeridianDb" connectionString="Data Source=SQL01;Initial Catalog=Meridian;Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="10240" />
    <globalization culture="en-US" uiCulture="en-US" />
    <sessionState mode="InProc" timeout="30" />
    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login.aspx" timeout="60" slidingExpiration="true" requireSSL="true" />
    </authentication>
    <authorization>
      <deny users="?" />
    </authorization>
    <membership defaultProvider="SqlProvider">
      <providers>
        <clear />
        <add name="SqlProvider" type="System.Web.Security.SqlMembershipProvider" connectionStringName="MeridianDb"
             applicationName="/Meridian" passwordFormat="Hashed" minRequiredPasswordLength="8"
             minRequiredNonalphanumericCharacters="0" />
      </providers>
    </membership>
    <roleManager enabled="true" defaultProvider="SqlRoles">
      <providers>
        <clear />
        <add name="SqlRoles" type="System.Web.Security.SqlRoleProvider" connectionStringName="MeridianDb" applicationName="/Meridian" />
      </providers>
    </roleManager>
    <machineKey validationKey="[redacted]" decryptionKey="[redacted]" validation="SHA1" decryption="AES" />
  </system.web>
  <location path="Account">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <log4net>
    <appender name="File" type="log4net.Appender.RollingFileAppender">
      <file value="App_Data\logs\portal.log" />
      <layout type="log4net.Layout.PatternLayout"><conversionPattern value="%date %level %logger - %message%newline" /></layout>
    </appender>
    <root><level value="INFO" /><appender-ref ref="File" /></root>
  </log4net>
</configuration>
